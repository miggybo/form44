<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="006-create-access-type-routing-table" author="system">
        <createTable tableName="access_type_routing">
            <column name="routing_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="access_type_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_routing_access_type" references="access_types(access_type_id)"/>
            </column>
            <column name="administrator_role" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="is_default" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
