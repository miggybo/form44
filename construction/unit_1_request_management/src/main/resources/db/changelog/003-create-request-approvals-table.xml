<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="003-create-request-approvals-table" author="system">
        <createTable tableName="request_approvals">
            <column name="approval_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="request_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_approvals_request" references="access_requests(request_id)"/>
            </column>
            <column name="approver_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="approval_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="comments" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
